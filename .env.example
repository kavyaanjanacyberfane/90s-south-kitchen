# Replace this with the final production domain before deployment.
NUXT_PUBLIC_SITE_URL=https://90ssouthkitchen.com

# Optional integrations: leave blank until the real IDs are available.
# Google Tag Manager container ID, e.g. GTM-XXXXXXX
NUXT_PUBLIC_GTM_ID=
# Optional direct Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
# Prefer GTM OR direct GA4 unless you intentionally configure both.
NUXT_PUBLIC_GA_MEASUREMENT_ID=
# Search Console HTML meta verification content (not the entire meta tag)
NUXT_PUBLIC_GSC_VERIFICATION=

# The quote form is demo-only. Add a secure backend/API endpoint before collecting submissions.
# FORM_SUBMISSION_ENDPOINT=
